# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public production URL where the app is hosted (e.g. https://formulario-inicial-velapp.vercel.app)
APP_URL="https://formulario-inicial-velapp.vercel.app"

# Google Cloud OAuth 2.0 Web Application Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Drive Destination Folder ID for patient PDFs
GOOGLE_DRIVE_FOLDER_ID="1GF3_uCNeiuevL7PsNiwXzIXRIuocrpK8"
