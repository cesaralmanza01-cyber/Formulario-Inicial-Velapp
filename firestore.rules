rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Doctor / Admin email check - strictly comerconcalma@gmail.com and testing account cesaralmanza01@gmail.com
    function isDoctor() {
      return isAuthenticated() && (
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'comerconcalma@gmail.com' ||
          request.auth.token.email.lower() == 'cesaralmanza01@gmail.com'
        )
      );
    }

    match /cuestionarios_iniciales/{questionnaireId} {
      // ONLY authenticated doctors can list/query all patient questionnaires
      allow list: if isDoctor();

      // An individual document can only be fetched by authenticated doctors
      allow get: if isDoctor();
      
      // Patient can create their own document matching their session ID, or doctor can create
      allow create: if isDoctor() || (request.resource.data.patientId == questionnaireId);
      
      // Patient can update their own document matching their session ID, or doctor can update
      allow update: if isDoctor() || (
        request.resource.data.patientId == questionnaireId && 
        resource.data.patientId == questionnaireId
      );
      
      // ONLY authenticated doctors can delete records
      allow delete: if isDoctor();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isDoctor();
    }

    match /_system_config/{docId} {
      allow read, write: if isDoctor();
    }
  }
}

