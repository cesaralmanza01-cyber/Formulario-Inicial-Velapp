rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Doctor / Admin email check - strictly comerconcalma@gmail.com and testing account cesaralmanza01@gmail.com
    function isDoctor() {
      return isAuthenticated() && (
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'comerconcalma@gmail.com' ||
          request.auth.token.email.lower() == 'cesaralmanza01@gmail.com'
        )
      );
    }

    match /cuestionarios_iniciales/{questionnaireId} {
      // Allow reading questionnaire (doctor portal, verification)
      allow read: if true;
      
      // Patient or Doctor can create & update questionnaires (including auto-save and closure)
      allow create: if true;
      allow update: if true;
      
      // Only doctor can delete
      allow delete: if isDoctor();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isDoctor();
    }
  }
}

