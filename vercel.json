{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?subpath=:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?subpath=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
